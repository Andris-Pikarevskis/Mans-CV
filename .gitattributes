
# CV asset types: preserve PDF/image/font bytes on Windows.
*.pdf binary
*.jpg binary
*.png binary
*.ttf binary
*.woff2 binary
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

.gitattributes text eol=lf
.gitignore text eol=lf
assets/fonts/OFL.txt text eol=lf
assets/vendor/boxicons/LICENSE.txt text eol=lf
